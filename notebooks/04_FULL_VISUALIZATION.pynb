# ===========================================================
# CUSTOMER SEGMENTATION – FULL VISUALIZATION NOTEBOOK SECTION
# ===========================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

# -----------------------------------------------------------
# LOAD DATA
# -----------------------------------------------------------
df = pd.read_excel("/mnt/data/cleaned_data_human_readable.xlsx")

# Select only numeric features for clustering
selected_features = df.select_dtypes(include=["float64", "int64", "bool"]).columns.tolist()

X = df[selected_features]

# -----------------------------------------------------------
# SCALING
# -----------------------------------------------------------
scaler = StandardScaler()
scaled_df = scaler.fit_transform(X)

# -----------------------------------------------------------
# FINDING OPTIMAL K (Elbow + Silhouette)
# -----------------------------------------------------------
inertia = []
sil_scores = []
K_range = range(2, 9)

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42)
    labels = kmeans.fit_predict(scaled_df)
    inertia.append(kmeans.inertia_)
    sil_scores.append(silhouette_score(scaled_df, labels))

# ----- PLOT ELBOW CURVE -----
plt.figure(figsize=(7,4))
plt.plot(K_range, inertia, marker="o")
plt.title("Elbow Curve – Optimal K")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Inertia")
plt.grid()
plt.show()

# ----- PLOT SILHOUETTE SCORE -----
plt.figure(figsize=(7,4))
plt.plot(K_range, sil_scores, marker="o", color="green")
plt.title("Silhouette Score – Model Quality vs K")
plt.xlabel("Number of Clusters (K)")
plt.ylabel("Silhouette Score")
plt.grid()
plt.show()

# -----------------------------------------------------------
# FINAL K (chosen = 4 but adaptive allowed)
# -----------------------------------------------------------
k_final = 4
kmeans = KMeans(n_clusters=k_final, random_state=42)
df["Cluster"] = kmeans.fit_predict(scaled_df)

# -----------------------------------------------------------
# PCA CLUSTER VISUALIZATION
# -----------------------------------------------------------
pca = PCA(n_components=2)
pca_data = pca.fit_transform(scaled_df)

df_plot = pd.DataFrame(pca_data, columns=["PC1", "PC2"])
df_plot["Cluster"] = df["Cluster"]

plt.figure(figsize=(8,6))
plt.scatter(df_plot["PC1"], df_plot["PC2"], c=df_plot["Cluster"], cmap="tab10", s=40)
plt.title("PCA Scatter Plot – Cluster Visualization")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.colorbar(label="Cluster")
plt.show()

# -----------------------------------------------------------
# CLUSTER SIZE BAR PLOT
# -----------------------------------------------------------
plt.figure(figsize=(7,4))
df["Cluster"].value_counts().sort_index().plot(kind='bar', edgecolor="black")
plt.title("Cluster Size Distribution")
plt.xlabel("Cluster")
plt.ylabel("Number of Items")
plt.show()

# -----------------------------------------------------------
# HEATMAP OF CLUSTER MEANS
# -----------------------------------------------------------
cluster_means = df.groupby("Cluster")[selected_features].mean()

plt.figure(figsize=(15,6))
sns.heatmap(cluster_means, cmap="YlGnBu", annot=False)
plt.title("Heatmap – Feature Means by Cluster")
plt.xlabel("Features")
plt.ylabel("Clusters")
plt.show()

# -----------------------------------------------------------
# RADAR CHARTS FOR EACH CLUSTER
# -----------------------------------------------------------
features = selected_features
cluster_means = df.groupby("Cluster")[features].mean()

num_vars = len(features)
angles = np.linspace(0, 2 * np.pi, num_vars, endpoint=False).tolist()

for c in cluster_means.index:
    values = cluster_means.loc[c].tolist()
    values += values[:1]
    angle_vals = angles + angles[:1]

    plt.figure(figsize=(6,6))
    plt.polar(angle_vals, values, linewidth=2)
    plt.fill(angle_vals, values, alpha=0.25)
    plt.title(f"Radar Chart – Cluster {c}")
    plt.xticks(angles, features, fontsize=6)
    plt.show()

# -----------------------------------------------------------

